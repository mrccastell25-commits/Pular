{
  "manifest_version": 3,
  "name": "Retro EQ - Captura de aba",
  "version": "1.0.0",
  "description": "Captura o áudio da aba atual e aplica um equalizador de seis bandas.",
  "permissions": ["tabCapture", "offscreen", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*.github.io/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Retro EQ"},
  "content_scripts": [{
    "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.github.io/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}